<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/topbar') %>

  <main>
    <!-- STEP A: POST-LOGIN MENU -->
    <section class="view is-active" id="view-menu">
      <a class="wizard-back" href="/home">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><%= t.wizardBack %></span>
      </a>

      <section class="hero">
        <p class="eyebrow"><%= t.menuEyebrow %></p>
        <h1><%= t.menuHeadline %></h1>
      </section>

      <section class="cards" aria-label="Kiosk actions">
        <button class="card card--kiosk" id="start-booking-btn" type="button">
          <span class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="36" height="36"><path d="M24 30a6 6 0 006-6V12a6 6 0 00-12 0v12a6 6 0 006 6z" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M36 22a12 12 0 01-24 0M24 34v6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
          </span>
          <span class="card-title"><%= t.menuBookTitle %></span>
          <span class="card-desc"><%= t.menuBookDesc %></span>
          <span class="card-cta">
            <span><%= t.menuBookCta %></span>
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>
      </section>
    </section>

    <!-- STEP B: AI Q&A + AUTO-BOOK -->
    <section class="view" id="view-booking">
      <div class="wizard-head">
        <button class="wizard-back" id="wizard-back-btn" type="button">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><%= t.wizardBack %></span>
        </button>
        <div class="qa-progress" id="qa-progress"></div>
      </div>

      <!-- QUESTION STEP (reused for each question) -->
      <div class="wizard-step is-active" id="wiz-question">
        <span class="ai-tag"><%= t.aiTag %></span>
        <h2 id="question-prompt">—</h2>
        <div class="chip-row" id="question-chips"></div>

        <div class="mic-row">
          <button class="mic-btn" id="mic-btn" aria-label="Start voice input" type="button">
            <svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 15a3 3 0 003-3V6a3 3 0 00-6 0v6a3 3 0 003 3z" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M19 11a7 7 0 01-14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
          <p class="mic-status" id="mic-status"><%= t.micIdle %></p>
        </div>

        <textarea id="answer-text" rows="3" placeholder=""></textarea>

        <button class="modal-primary-btn wizard-next" id="answer-next-btn" type="button"><%= t.answerNext %></button>
      </div>

      <!-- BOOKING (auto) -->
      <div class="wizard-step" id="wiz-autobook">
        <div class="scan-spinner-wrap"><div class="emg-spinner" aria-hidden="true"></div></div>
        <h2 class="scan-center"><%= t.autobookTitle %></h2>
        <p class="wizard-sub scan-center"><%= t.autobookSub %></p>
      </div>

      <!-- CONFIRM -->
      <div class="wizard-step" id="wiz-confirm">
        <div class="success-check success-check--lg" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="36" height="36"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h2 class="scan-center"><%= t.confirmTitle %></h2>

        <div class="token-block">
          <span class="token-label"><%= t.confirmToken %></span>
          <span class="token-value" id="confirm-token">—</span>
        </div>

        <div class="confirm-card">
          <div class="confirm-row"><span><%= t.confirmSpecialty %></span><strong id="confirm-specialty">—</strong></div>
          <div class="confirm-row"><span><%= t.confirmWhen %></span><strong id="confirm-when">—</strong></div>
        </div>
        <p class="wizard-sub scan-center"><%= t.confirmNote %></p>

        <p class="redirect-note scan-center">
          <span><%= t.redirectNote %></span>
          <span id="redirect-seconds">10</span><span><%= t.redirectSeconds %></span>
        </p>
        <button class="modal-secondary-btn" id="confirm-done-btn" type="button"><%= t.confirmDone %></button>
      </div>
    </section>
  </main>

  <%- include('partials/emergency-button') %>
  <%- include('partials/footer') %>

  <div class="modal-backdrop" id="modal-backdrop">
    <%- include('partials/emergency-modal') %>
  </div>

  <script>
    window.TRIVIDHA_DICT = <%- JSON.stringify(t) %>;
    window.TRIVIDHA_QUESTIONS = <%- JSON.stringify(questions) %>;
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/book-appointment.js"></script>
</body>
</html>
