<!-- Emergency Red Flag Alert Modal -->
<div id="emergencyModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4">
  <div class="bg-slate-900 border-2 border-rose-500 rounded-2xl max-w-lg w-full p-6 sm:p-8 text-center shadow-2xl shadow-rose-950/60 relative animate-in fade-in zoom-in duration-200">
    <div class="w-16 h-16 rounded-full bg-rose-500/20 border-2 border-rose-500 flex items-center justify-center text-rose-500 text-3xl mx-auto mb-4 animate-bounce">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h2 class="text-2xl font-bold text-white mb-2"><%= dict.emgTitle || 'Connecting you to the Emergency Triage Desk' %></h2>
    <p class="text-rose-200/90 text-sm mb-6 leading-relaxed">
      <%= dict.emgSub || 'Please remain seated. A triage nurse and medical officer have been dispatched to this kiosk.' %>
    </p>

    <div class="p-4 rounded-xl bg-rose-950/40 border border-rose-500/30 text-left mb-6 space-y-2 text-xs">
      <div class="flex items-center justify-between text-slate-300">
        <span>Kiosk Terminal:</span>
        <span class="font-semibold text-white">OPD Block A · Terminal #04</span>
      </div>
      <div class="flex items-center justify-between text-slate-300">
        <span>Triage Protocol:</span>
        <span class="font-semibold text-rose-400">Level 1 Emergency Dispatch</span>
      </div>
      <div class="flex items-center justify-between text-slate-300">
        <span>Emergency Medical Officer:</span>
        <span class="font-semibold text-white">Room 101 Resuscitation Team</span>
      </div>
    </div>

    <div class="flex gap-3 justify-center">
      <button onclick="window.closeEmergencyModal()" class="px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-medium border border-slate-700 transition-colors">
        Cancel Alert
      </button>
      <a href="tel:108" class="px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-sm font-semibold shadow-lg shadow-rose-600/30 transition-colors flex items-center gap-2">
        <i class="fa-solid fa-phone"></i> Call Emergency 108
      </a>
    </div>
  </div>
</div>

<!-- QR Code Modal -->
<div id="qrModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 sm:p-8 text-center shadow-2xl relative">
    <div class="w-12 h-12 rounded-xl bg-teal-500/20 text-teal-400 text-2xl flex items-center justify-center mx-auto mb-4">
      <i class="fa-solid fa-qrcode"></i>
    </div>
    <h3 class="text-xl font-bold text-white mb-2"><%= dict.qrModalTitle || 'Scan to continue on your phone' %></h3>
    <p class="text-slate-400 text-xs mb-6">
      <%= dict.qrModalSub || "Open your phone's camera and point it at this code to complete pre-intake on your mobile device." %>
    </p>

    <!-- Simulated QR Code -->
    <div class="p-4 bg-white rounded-2xl inline-block shadow-xl mb-6">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https://trividha.hospital.in/mobile-intake?kiosk=4&lang=<%= selectedLang %>" alt="QR Code" class="w-44 h-44" />
    </div>

    <button onclick="window.closeQrModal()" class="w-full py-3 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-sm transition-colors">
      <%= dict.qrModalBtn || 'Done' %>
    </button>
  </div>
</div>
